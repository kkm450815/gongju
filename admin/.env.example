# Copy to .env.local and fill in values from your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role key — required for the dashboard to read across users.
# NEVER expose this in the browser or commit it. Only used in server-side route handlers.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Where the public landing page lives — used to compose UTM links and short URLs
NEXT_PUBLIC_LANDING_BASE_URL=https://gongju.game
