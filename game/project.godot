; gongju — Godot 4 project file
; Open this file with Godot 4.x (Standard build) and press F5 to run.

config_version=5

[application]

config/name="gongju"
config/description="A god game over a modern town"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DataLoader="*res://scripts/systems/data_loader.gd"
I18N="*res://scripts/systems/i18n.gd"
TimeSystem="*res://scripts/systems/time_system.gd"
WeatherSystem="*res://scripts/systems/weather_system.gd"
EconomySystem="*res://scripts/systems/economy_system.gd"
FaithSystem="*res://scripts/systems/faith_system.gd"
DisasterSystem="*res://scripts/systems/disaster_system.gd"
TownRegistry="*res://scripts/systems/town_registry.gd"
AudioSystem="*res://scripts/systems/audio_system.gd"
SaveSystem="*res://scripts/systems/save_system.gd"
RemoteConfig="*res://scripts/systems/remote_config.gd"
Telemetry="*res://scripts/systems/telemetry.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.043, 0.055, 0.102, 1)
